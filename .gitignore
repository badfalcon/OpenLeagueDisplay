__pycache__/
*.pyc
.DS_Store
.vscode/
# Local-dev venv (uv or venv). Don't commit to the repo
.venv/
# Ignore .idea/ in general, but check in only the shared Run Configurations
.idea/*
!.idea/runConfigurations/
# Written by generate_data.py only when it detects a missing new champion. It's
# meant to be deleted after update.yml's auto-file step reads it, so don't commit
unmapped_regions.json
# PyInstaller (local_app.spec) build artifacts. Ignored since binaries aren't kept
# in the repo (release.yml distributes them as Release assets). The spec itself is separate (committed)
build/
dist/
# Inno Setup (installer/windows.iss) build artifact (setup.exe). Ignored for the same reason.
# The iss itself is committed
installer/out/
